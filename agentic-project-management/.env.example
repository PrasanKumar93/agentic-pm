NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Persistence
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=agentic_pm
REDIS_URL=redis://localhost:6380

# Tracker integration
AGENTIC_PM_TRACKER=fake
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_WEBHOOK_TOLERANCE_MS=60000
LINEAR_ACTIVE_STATES=Ready for Agent,Changes Requested
LINEAR_RUNNING_STATE=Agent Running
LINEAR_REVIEW_STATE=Human Review

# Workspace and runtime
AGENTIC_PM_WORKSPACE_ROOT=./workspaces
AGENTIC_PM_ARTIFACT_ROOT=./artifacts
AGENTIC_PM_ENABLE_HOOKS=false
AGENTIC_PM_RUN_ONCE=false
AGENT_RUNTIME=fake
AGENT_RUNTIME_TURN_TIMEOUT_MS=3600000
AGENT_RUNTIME_STALL_TIMEOUT_MS=300000
AGENT_RUNTIME_CANCEL_GRACE_MS=5000
OPENAI_API_KEY=
CODEX_API_KEY=
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.1-codex
CODEX_REASONING_EFFORT=medium
CODEX_ARGS=--ask-for-approval never --sandbox workspace-write exec --json -

# Cursor Agent CLI adapter. Set AGENT_RUNTIME=cursor to use these.
CURSOR_API_KEY=
CURSOR_COMMAND=cursor-agent
CURSOR_ARGS=
CURSOR_OUTPUT_FORMAT=stream-json
CURSOR_MODEL=
CURSOR_FORCE=false
CURSOR_SANDBOX=enabled
CURSOR_TRUST_WORKSPACE=true

# Generic CLI adapter for noninteractive tools such as local wrappers around Cursor or other agents.
# Set AGENT_RUNTIME=generic to use these.
AGENT_RUNTIME_NAME=generic-cli
AGENT_RUNTIME_COMMAND=
AGENT_RUNTIME_ARGS=
