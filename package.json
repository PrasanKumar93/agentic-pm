{
  "name": "agentic-project-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/with-corepack-pnpm-path.mjs turbo dev",
    "dev:api": "node scripts/with-corepack-pnpm-path.mjs pnpm --filter @agentic-pm/api dev",
    "dev:worker": "node scripts/with-corepack-pnpm-path.mjs pnpm --filter @agentic-pm/worker dev",
    "dev:web": "node scripts/with-corepack-pnpm-path.mjs pnpm --filter @agentic-pm/web dev",
    "build": "node scripts/with-corepack-pnpm-path.mjs turbo build",
    "cleanup:smoke": "node scripts/with-corepack-pnpm-path.mjs pnpm --filter @agentic-pm/db cleanup:smoke",
    "cleanup:workspaces": "node scripts/with-corepack-pnpm-path.mjs pnpm --filter @agentic-pm/workspaces cleanup:workspaces",
    "linear:webhook": "node scripts/with-corepack-pnpm-path.mjs pnpm --filter @agentic-pm/api linear:webhook",
    "lint": "node scripts/with-corepack-pnpm-path.mjs turbo lint",
    "smoke:codex-auth-write": "node apps/worker/scripts/smoke-codex-auth-write.mjs",
    "smoke:linear-webhook": "node apps/api/scripts/smoke-linear-webhook.mjs",
    "typecheck": "node scripts/with-corepack-pnpm-path.mjs turbo typecheck",
    "test": "node scripts/with-corepack-pnpm-path.mjs turbo test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
