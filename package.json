{
  "name": "agentic-project-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @agentic-pm/api dev",
    "dev:worker": "pnpm --filter @agentic-pm/worker dev",
    "dev:web": "pnpm --filter @agentic-pm/web dev",
    "build": "turbo build",
    "cleanup:smoke": "pnpm --filter @agentic-pm/db cleanup:smoke",
    "lint": "turbo lint",
    "smoke:codex-auth-write": "node apps/worker/scripts/smoke-codex-auth-write.mjs",
    "smoke:linear-webhook": "node apps/api/scripts/smoke-linear-webhook.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
