{
  "name": "@agentic-pm/workspaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cleanup:workspaces": "node scripts/cleanup-generated-workspaces.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@agentic-pm/core": "workspace:*",
    "@agentic-pm/observability": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
